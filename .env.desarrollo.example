# Plantilla del entorno LOCAL de pruebas.
#
# Copiar a `.env.desarrollo` (ese sí queda fuera de git) y completar con lo que
# imprime `supabase status` después de `supabase start`.
#
# Con esto, `npm run dev:local` levanta la app apuntando a la base local, y
# `npm run dev` sigue apuntando a donde apunta hoy `.env.local`. Vite le da
# prioridad a `.env.desarrollo` sobre `.env.local` cuando el modo es
# "desarrollo", así que los dos entornos conviven sin pisarse.
#
# NUNCA poner acá claves de producción.

# Lo imprime `supabase status` como "API URL". Con --host, el celular entra por
# la IP de la PC y no por localhost: ahí hay que poner http://<IP>:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Lo imprime `supabase status` como "anon key". Es una clave de juguete, fija y
# pública del stack local: no sirve para nada fuera de esta máquina.
VITE_SUPABASE_ANON_KEY=
